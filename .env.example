# --- Serveur ---
NODE_ENV=development
PORT=4000
# Origines autorisées (web/dev). L'application mobile n'envoie pas d'en-tête Origin.
CORS_ORIGINS=http://localhost:8081

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017/maintenance_sdr
# Nom de la base (utile si l URI Atlas n en précise pas)
MONGODB_DB=maintenance_sdr

# --- Authentification (générer avec: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Secret utilisé pour signer les liens de téléchargement temporaires
DOWNLOAD_URL_SECRET=change-me-download-secret-at-least-32-chars
PUBLIC_BASE_URL=http://localhost:4000

# --- UploadThing (stockage des documents) ---
# Token disponible dans le tableau de bord UploadThing > API Keys
UPLOADTHING_TOKEN=
# public-read (offre gratuite UploadThing) | private (offres payantes uniquement)
UPLOADTHING_ACL=public-read
# local = stockage disque (développement/tests), uploadthing = production
STORAGE_DRIVER=uploadthing
LOCAL_STORAGE_DIR=./storage

# --- OpenRouter (IA) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modèle principal (texte + sorties JSON structurées). Vérifier le slug exact sur openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Moteur OCR pour PDF scannés / images (plugin file-parser d'OpenRouter): mistral-ocr | pdf-text
OPENROUTER_PDF_ENGINE=mistral-ocr
# Désactive la conservation des données côté fournisseurs (routage OpenRouter data_collection=deny)
OPENROUTER_DENY_DATA_COLLECTION=true

# --- Notifications push (Expo) ---
# Facultatif : jeton d'accès Expo si la sécurité renforcée des push est activée
EXPO_ACCESS_TOKEN=

# --- Réinitialisation du mot de passe ---
# Code de récupération défini à la création du compte (voir README). Aucun e-mail n'est envoyé.
